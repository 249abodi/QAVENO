# QAVENO — Production Environment Variables
# Copy to .env and fill in production values.

# ── Node ────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000

# ── Database (PostgreSQL) ───────────────────────────────────────
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=qaveno
POSTGRES_PASSWORD=
POSTGRES_DB=qaveno

# ── JWT Authentication ──────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_ISSUER=qaveno-backend

# ── Token TTLs (seconds) ───────────────────────────────────────
ACCESS_TTL_SEC=900
REFRESH_TTL_SEC=604800

# ── CORS (comma-separated origins for production) ───────────────
CORS_ORIGINS=https://qaveno.com,https://www.qaveno.com,https://owner.qaveno.com

# ── Rate Limiting ───────────────────────────────────────────────
RATE_LIMIT_TTL_SEC=60
RATE_LIMIT_MAX=100

# ── Trial HMAC Secret ───────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
QAVENO_TRIAL_SECRET=

# ── Swagger (set true only in staging) ──────────────────────────
SWAGGER_ENABLED=false
