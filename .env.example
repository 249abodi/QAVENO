# QAVENO — Production Environment Variables
# Copy to .env and fill in production values.

# ── Node ────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000

# ── Database (PostgreSQL) ───────────────────────────────────────
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=qaveno
POSTGRES_PASSWORD=
POSTGRES_DB=qaveno

# ── JWT Authentication ──────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_ISSUER=qaveno-backend

# ── Token TTLs (seconds) ───────────────────────────────────────
ACCESS_TTL_SEC=900
REFRESH_TTL_SEC=604800

# ── CORS (comma-separated origins for production) ───────────────
CORS_ORIGINS=https://qaveno.com,https://www.qaveno.com,https://owner.qaveno.com

# ── Rate Limiting ───────────────────────────────────────────────
RATE_LIMIT_TTL_SEC=60
RATE_LIMIT_MAX=100

# ── Trial Ed25519 signing key ─────────────────────────────────
# The Ed25519 private key (PKCS#8 DER Base64, or PEM) used to sign trial
# tokens. Clients verify with the public half only; never set this to the
# test key. Generate a new pair before production deploy.
QAVENO_TRIAL_PRIVATE_KEY=
# Key id embedded in every signed trial token (rotation support).
QAVENO_TRIAL_KEY_ID=prod-1

# ── Swagger (set true only in staging) ──────────────────────────
SWAGGER_ENABLED=false
